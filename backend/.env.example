DATABASE_URL=postgresql://migration_user:migration_pass@localhost:5432/migration_assessment
AWS_REGIONS=me-central-1
AWS_LOCATIONS=Middle East (UAE)
CATALOG_FAMILY_DENYLIST_PREFIXES=u-,u7i,mac,dl1,dl2,p2,p3,p4,p5,g3,g4,g5,g6,trn,inf,hpc,f1,vt1
CPU_PERF_RATIO_PATH=config/cpu_perf_ratio.yaml

# Bedrock (Strands). Use an ID enabled in Bedrock -> Model access; copy it exactly from the console.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-east-1
DEFAULT_ASSESSMENT_REGION=me-central-1
DEFAULT_PROVIDER=aws

# Azure
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
DEFAULT_AZURE_REGION=uaenorth
# az login (or a service principal via AZURE_CLIENT_ID/AZURE_CLIENT_SECRET/AZURE_TENANT_ID
# env vars) must succeed before DefaultAzureCredential can authenticate.
